@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix mbod: <https://w3id.org/mbo/shapes/dcat-ap#> .

# A SUBSET of the DCAT-AP 3.0 requirements, written by hand: the mandatory
# properties of Catalogue, Dataset, Distribution and Agent, plus a few
# recommended ones as warnings. It does NOT replace the official SHACL shapes
# of DCAT-AP (https://semiceu.github.io/DCAT-AP/releases/3.0.0/); run those too
# before submitting the catalogue to a portal.

mbod:CatalogShape a sh:NodeShape ;
    sh:targetClass dcat:Catalog ;
    sh:property [ sh:path dct:title ; sh:minCount 1 ; sh:nodeKind sh:Literal ] ;
    sh:property [ sh:path dct:description ; sh:minCount 1 ; sh:nodeKind sh:Literal ] ;
    sh:property [ sh:path dct:publisher ; sh:minCount 1 ; sh:maxCount 1 ; sh:class foaf:Agent ] ;
    sh:property [ sh:path dcat:dataset ; sh:minCount 1 ; sh:class dcat:Dataset ] ;
    sh:property [ sh:path dct:license ; sh:severity sh:Warning ; sh:minCount 1 ] .

mbod:DatasetShape a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    sh:property [ sh:path dct:title ; sh:minCount 1 ; sh:nodeKind sh:Literal ] ;
    sh:property [ sh:path dct:description ; sh:minCount 1 ; sh:nodeKind sh:Literal ] ;
    sh:property [ sh:path dcat:distribution ; sh:minCount 1 ; sh:class dcat:Distribution ; sh:severity sh:Warning ] ;
    sh:property [ sh:path dct:publisher ; sh:minCount 1 ; sh:class foaf:Agent ; sh:severity sh:Warning ] ;
    sh:property [ sh:path dcat:keyword ; sh:minCount 1 ; sh:severity sh:Warning ] .

mbod:DistributionShape a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    sh:property [ sh:path dcat:accessURL ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:format ; sh:minCount 1 ; sh:severity sh:Warning ] ;
    sh:property [ sh:path dct:license ; sh:minCount 1 ; sh:severity sh:Warning ] .

mbod:AgentShape a sh:NodeShape ;
    sh:targetClass foaf:Agent ;
    sh:property [ sh:path foaf:name ; sh:minCount 1 ; sh:nodeKind sh:Literal ] .
