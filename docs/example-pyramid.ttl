    dct:description "Illustrative example. Layer sizes follow the author's reconstruction; the tiling of single bricks is a deterministic greedy layout, not the measured one."@en ;
    dct:source mbos:user-chat-pyramid ;
    rdfs:label "Stepped white pyramid with column"@en ;
