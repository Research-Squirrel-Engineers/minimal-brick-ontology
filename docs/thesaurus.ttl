mbot:unit
    a skos:ConceptScheme ;
    dct:creator "Research Squirrel Engineers" ;
    dct:description "Grid and measurement units of the brick system."@en ;
    dct:issued "2026-11-18"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-11-18"^^xsd:date ;
    skos:hasTopConcept <https://w3id.org/mbo/thesaurus/unit/brick-height>, <https://w3id.org/mbo/thesaurus/unit/ldu>, <https://w3id.org/mbo/thesaurus/unit/lego-unit>, <https://w3id.org/mbo/thesaurus/unit/part-gap>, <https://w3id.org/mbo/thesaurus/unit/plate-height>, <https://w3id.org/mbo/thesaurus/unit/stud-diameter>, <https://w3id.org/mbo/thesaurus/unit/stud-height>, <https://w3id.org/mbo/thesaurus/unit/stud-pitch> ;
    skos:prefLabel "Einheiten"@de, "Units"@en .

<https://w3id.org/mbo/thesaurus/unit/brick-height>
    a skos:Concept, mbo:Unit ;
    dct:source mbos:brickfact-dimensions, mbos:lugnet-dimensions ;
    skos:definition "Height of a brick without stud; three plates."@en ;
    skos:inScheme mbot:unit ;
    skos:note "Measured 9.582 mm (munafo-measured)."@en ;
    skos:prefLabel "Brick height"@en, "Steinhöhe"@de ;
    skos:topConceptOf mbot:unit ;
    mbo:nominalMm "9.6"^^xsd:decimal ;
    mbo:verification "sourced" .

<https://w3id.org/mbo/thesaurus/unit/ldu>
    a skos:Concept, mbo:Unit ;
    dct:source mbos:lugnet-dimensions, mbos:orionrobots-specs ;
    skos:definition "Unit of the LDraw format; 1 LDU = 0.4 mm. Brick height 24, plate height 8, stud pitch 20."@en ;
    skos:inScheme mbot:unit ;
    skos:prefLabel "LDraw unit (LDU)"@en, "LDraw-Einheit"@de ;
    skos:topConceptOf mbot:unit ;
    mbo:nominalMm "0.4"^^xsd:decimal ;
    mbo:verification "sourced" .

<https://w3id.org/mbo/thesaurus/unit/lego-unit>
    a skos:Concept, mbo:Unit ;
    dct:source mbos:lugnet-dimensions, mbos:zoeblade-dimensions ;
    skos:definition "1.6 mm; a stud pitch is 5 LU, a plate 2 LU, a brick 6 LU."@en ;
    skos:inScheme mbot:unit ;
    skos:note "lugnet-dimensions words this as 'I believe'."@en ;
    skos:prefLabel "LEGO unit (LU)"@en, "LEGO-Einheit"@de ;
    skos:topConceptOf mbot:unit ;
    mbo:nominalMm "1.6"^^xsd:decimal ;
    mbo:verification "sourced" .

<https://w3id.org/mbo/thesaurus/unit/part-gap>
    a skos:Concept, mbo:Unit ;
    dct:source mbos:brick-dimensions, mbos:brickfact-dimensions ;
    skos:definition "Each part is 0.2 mm shorter than its grid, 0.1 mm per side."@en ;
    skos:inScheme mbot:unit ;
    skos:prefLabel "Part gap"@en, "Teilefuge"@de ;
    skos:topConceptOf mbot:unit ;
    mbo:nominalMm "0.2"^^xsd:decimal ;
    mbo:verification "sourced" .

<https://w3id.org/mbo/thesaurus/unit/plate-height>
    a skos:Concept, mbo:Unit ;
