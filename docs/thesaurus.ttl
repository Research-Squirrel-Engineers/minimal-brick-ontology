mbot:feature
    a skos:ConceptScheme ;
    dct:creator "Research Squirrel Engineers" ;
    dct:description "Geometric and connective features of parts."@en ;
    dct:issued "2026-11-18"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-11-18"^^xsd:date ;
    skos:hasTopConcept <https://w3id.org/mbo/thesaurus/feature/hollow-underside>, <https://w3id.org/mbo/thesaurus/feature/stud>, <https://w3id.org/mbo/thesaurus/feature/underside-tube> ;
    skos:prefLabel "Features"@en, "Merkmale"@de .

<https://w3id.org/mbo/thesaurus/feature/hollow-underside>
    a skos:Concept, mbo:Feature ;
    dct:source mbos:diyhpl-dimensions ;
    skos:definition "Cavity enclosed by the walls on the underside of a brick."@en ;
    skos:inScheme mbot:feature ;
    skos:prefLabel "Hohle Unterseite"@de, "Hollow underside"@en ;
    skos:topConceptOf mbot:feature ;
    mbo:verification "sourced" .

<https://w3id.org/mbo/thesaurus/feature/stud>
    a skos:Concept, mbo:Feature ;
    dct:source mbos:brickfact-dimensions, mbos:brickowl-stud-dimensions ;
    skos:definition "Cylindrical protrusion on top of an element; nominal diameter 4.8 mm and height about 1.7 mm."@en ;
    skos:inScheme mbot:feature ;
    skos:note "Variant values: Ø 4.5 to 5 mm, height 1.6 to 1.86 mm (orionrobots-specs, diyhpl-dimensions)."@en ;
    skos:prefLabel "Noppe"@de, "Stud"@en ;
    skos:topConceptOf mbot:feature ;
    mbo:verification "sourced" .

<https://w3id.org/mbo/thesaurus/feature/underside-tube>
    a skos:Concept, mbo:Feature ;
    dct:source mbos:diyhpl-dimensions ;
    skos:definition "Cylinder on the underside of a brick; the source gives an outer diameter of about 6.3 to 6.6 mm."@en ;
    skos:inScheme mbot:feature ;
    skos:prefLabel "Underside tube"@en, "Unterseitenröhre"@de ;
    skos:topConceptOf mbot:feature ;
    mbo:verification "sourced" .

