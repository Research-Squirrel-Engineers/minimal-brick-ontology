@prefix dct: <http://purl.org/dc/terms/> .
@prefix mbo: <https://w3id.org/mbo/ontology#> .
@prefix mbos: <https://w3id.org/mbo/source/> .
@prefix mbot: <https://w3id.org/mbo/thesaurus/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mbos:brick-dimensions
    a dct:BibliographicResource ;
    dct:title "LEGO brick dimensions calculator (computed geometry, unofficial)"@en ;
    dct:type "community" ;
    rdfs:comment "Footprint = studs x 8 mm - 0.2 mm; common part sizes; baseplate 32x32 = 256 mm; cites LUGNET FAQ and LDraw spec"@en ;
    rdfs:seeAlso <https://brick-dimensions.pages.dev/> .

mbos:brickarchitect-colour
    a dct:BibliographicResource ;
    dct:title "Understanding the Lego Colour Palette (Tom Alphin, BrickArchitect)"@en ;
    dct:type "community" ;
    rdfs:comment "LEGO names versus enthusiast names; 2016 palette counts"@en ;
    rdfs:seeAlso <https://brickarchitect.com/color/> .

mbos:brickfact-dimensions
    a dct:BibliographicResource ;
    dct:title "Lego brick dimensions (Brickfact)"@en ;
    dct:type "community" ;
    rdfs:comment "8 mm grid; brick 9.6 mm; plate 3.2 mm; stud 4.8 mm x about 1.7 mm; 0.2 mm gap per part"@en ;
    rdfs:seeAlso <https://brickfact.com/blog/guidebooks/lego-brick-dimensions> .

mbos:brickfact-identify
    a dct:BibliographicResource ;
    dct:title "How to identify Lego pieces: design ID, element ID and colour (Brickfact)"@en ;
    dct:type "community" ;
    rdfs:comment "Design ID is moulded on the piece; LEGO, BrickLink and Rebrickable numbers and colour names differ; round plate 1x1 = LEGO 6141 / BrickLink 4073; tile 1x2 = 3069b"@en ;
    rdfs:seeAlso <https://brickfact.com/blog/guidebooks/identify-lego-pieces> .

mbos:brickimedia-colour
    a dct:BibliographicResource ;
    dct:title "Colour palette (Brickimedia), read via search snippet only"@en ;
    dct:type "community" ;
    rdfs:comment "Colour IDs 26 Black, 194 Medium Stone Grey, 199 Dark Stone Grey, 1 White; the page itself was not fetchable"@en ;
    rdfs:seeAlso <https://en.brickimedia.org/wiki/Color_palette> .

mbos:brickipedia-colour
    a dct:BibliographicResource ;
    dct:title "Colour Palette (Brickipedia)"@en ;
    dct:type "community" ;
    rdfs:comment "Colour IDs 1 White, 5 Brick Yellow, 18 Nougat, 104 Bright Violet"@en ;
    rdfs:seeAlso <https://brickipedia.fandom.com/wiki/Colour_Palette> .

mbos:brickowl-stud-dimensions
    a dct:BibliographicResource ;
    dct:title "Stud Dimensions Guide (Brick Owl)"@en ;
    dct:type "vendor" ;
    rdfs:comment "Plate height 3.2 mm; stud height 1.7 mm; bar diameter 3.2 mm; Technic pin 4.8 mm"@en ;
    rdfs:seeAlso <https://www.brickowl.com/help/stud-dimensions> .

mbos:diyhpl-dimensions
    a dct:BibliographicResource ;
    dct:title "LEGO dimensions.yaml (diyhpl.us)"@en ;
    dct:type "community" ;
    rdfs:comment "Underside cylinders and tubes, wall thicknesses, variant values"@en ;
    rdfs:seeAlso <https://diyhpl.us/cgit/lego/tree/dimensions.yaml> .

mbos:ldraw-forum-numbers
    a dct:BibliographicResource ;
    dct:title "LDraw forum: part number translation"@en ;
    dct:type "community" ;
    rdfs:comment "Different numbering systems (LDraw, LEGO, BrickLink) for the same part"@en ;
    rdfs:seeAlso <https://forums.ldraw.org/printthread.php?tid=23337> .

mbos:lugnet-dimensions
    a dct:BibliographicResource ;
    dct:title "LUGNET FAQ: building dimensions"@en ;
    dct:type "community" ;
    rdfs:comment "Brick height 9.6 mm, plate 3.2 mm, stud pitch 8.0 mm; LDU units 24/8/20; LU 6/2/5"@en ;
    rdfs:seeAlso <https://lugnet.com/~330/FAQ/Build/dimensions> .

mbos:newelementary-parts
    a dct:BibliographicResource ;
    dct:title "New LEGO parts lists (New Elementary)"@en ;
    dct:type "community" ;
    rdfs:comment "Shows design ID versus element ID per colour, TLG names and Rebrickable names"@en ;
    rdfs:seeAlso <https://www.newelementary.com/2022/03/what-are-new-lego-parts-for-march-2022.html> .

mbos:orionrobots-specs
    a dct:BibliographicResource ;
    dct:title "Lego specifications (Orion Robots)"@en ;
    dct:type "community" ;
    rdfs:comment "Stud spacing 8; stud diameter 5 (approx); LDU = 0.4 mm"@en ;
    rdfs:seeAlso <https://orionrobots.co.uk/Lego%2BSpecifications> .

mbos:rebrickable-api
    a dct:BibliographicResource ;
    dct:title "Rebrickable API documentation"@en ;
    dct:type "community" ;
    rdfs:comment "Parts, colours, sets and inventories; external BrickLink and BrickOwl identifiers"@en ;
    rdfs:seeAlso <https://rebrickable.com/api/v3/docs/> .

mbos:seed-unverified
    a dct:BibliographicResource ;
    dct:title "Author-supplied seed value, not confirmed by a retrieved source"@en ;
    dct:type "seed" ;
    rdfs:comment "Value written from general knowledge; replaced or confirmed when the Rebrickable download is processed"@en ;
    rdfs:seeAlso <https://github.com/Research-Squirrel-Engineers/minimal-brick-ontology> .

mbos:zoeblade-colour
    a dct:BibliographicResource ;
    dct:title "Lego colour (Zoe Blade's notebook)"@en ;
    dct:type "community" ;
    rdfs:comment "Classic (1950-1977) and current common colours with BrickLink name, LEGO ID and Gobricks ID; no hex values"@en ;
    rdfs:seeAlso <https://notebook.zoeblade.com/Lego_colour.html> .

mbos:zoeblade-dimensions
    a dct:BibliographicResource ;
    dct:title "Lego brick dimensions (Zoe Blade's notebook)"@en ;
    dct:type "community" ;
    rdfs:comment "All dimensions are multiples of a 1.6 mm unit; module = 5 units = 8 mm"@en ;
    rdfs:seeAlso <https://notebook.zoeblade.com/Lego_brick_dimensions.html> .

mbot:colour
    a skos:ConceptScheme ;
    dct:creator "Research Squirrel Engineers" ;
    dct:description "LEGO colours with names, identifiers, hex approximations and finish groups."@en ;
    dct:issued "2026-11-18"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-11-18"^^xsd:date ;
    skos:hasTopConcept <https://w3id.org/mbo/thesaurus/colour/group-metallic>, <https://w3id.org/mbo/thesaurus/colour/group-solid>, <https://w3id.org/mbo/thesaurus/colour/group-special>, <https://w3id.org/mbo/thesaurus/colour/group-transparent> ;
    skos:prefLabel "Colours"@en, "Farben"@de .

<https://w3id.org/mbo/thesaurus/colour/black>
